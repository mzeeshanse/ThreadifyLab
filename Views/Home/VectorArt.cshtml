@model IEnumerable<VectorArt>
@{
    ViewData["Title"] = "Vector Art";
}

<section class="page-header">
    <div class="container">
        <h1>Vector Art Services</h1>
        <p>Explore our collection of professional vector art and digitization services</p>
    </div>
</section>

<section class="cap-logo-section">
    <div class="container">
        <div class="cap-logo-grid">
            @foreach (var vectorArt in Model.Where(v => v.IsActive).OrderBy(v => v.DisplayOrder))
            {
                <div class="cap-logo-card">
                    <div class="cap-logo-image">
                        <img src="@vectorArt.ImageUrl" alt="@vectorArt.Title" />
                    </div>
                    <div class="cap-logo-content">
                        <h3>@vectorArt.Title</h3>
                        <p>@vectorArt.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <h2>Need Custom Vector Art?</h2>
            <p>Contact us today to discuss your vector art and digitization project</p>
            <a asp-controller="Home" asp-action="Contact" class="btn btn-primary btn-large">Get a Quote</a>
        </div>
    </div>
</section>

