@model IEnumerable<JacketBack>
@{
    ViewData["Title"] = "Jacket Back";
}

<section class="page-header">
    <div class="container">
        <h1>Jacket Back Designs</h1>
        <p>Explore our collection of professional jacket back logo digitizing services</p>
    </div>
</section>

<section class="cap-logo-section">
    <div class="container">
        <div class="cap-logo-grid">
            @foreach (var jacketBack in Model.Where(j => j.IsActive).OrderBy(j => j.DisplayOrder))
            {
                <div class="cap-logo-card">
                    <div class="cap-logo-image image-modal-trigger" data-image-src="@jacketBack.ImageUrl" data-image-alt="@jacketBack.Title">
                        <img src="@jacketBack.ImageUrl" alt="@jacketBack.Title" />
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <h2>Need a Custom Jacket Back Design?</h2>
            <p>Contact us today to discuss your jacket back digitizing project</p>
            <a asp-controller="Home" asp-action="Contact" class="btn btn-primary btn-large">Get a Quote</a>
        </div>
    </div>
</section>










