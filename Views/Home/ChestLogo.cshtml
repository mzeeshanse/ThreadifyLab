@model IEnumerable<ChestLogo>
@{
    ViewData["Title"] = "Chest Logo";
}

<section class="page-header">
    <div class="container">
        <h1>Chest Logo Designs</h1>
        <p>Explore our collection of professional chest logo digitizing services</p>
    </div>
</section>

<section class="cap-logo-section">
    <div class="container">
        <div class="cap-logo-grid">
            @foreach (var chestLogo in Model.Where(c => c.IsActive).OrderBy(c => c.DisplayOrder))
            {
                <div class="cap-logo-card">
                    <div class="cap-logo-image">
                        <img src="@chestLogo.ImageUrl" alt="@chestLogo.Title" />
                    </div>
                    <div class="cap-logo-content">
                        <h3>@chestLogo.Title</h3>
                        <p>@chestLogo.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <h2>Need a Custom Chest Logo?</h2>
            <p>Contact us today to discuss your chest logo digitizing project</p>
            <a asp-controller="Home" asp-action="Contact" class="btn btn-primary btn-large">Get a Quote</a>
        </div>
    </div>
</section>

