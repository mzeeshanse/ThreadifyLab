@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="container">
        <div class="hero-content">
            <h1>Professional Embroidery Digitizing Services</h1>
            <p class="hero-subtitle">Transform your designs into high-quality embroidery files with precision and expertise</p>
            <div class="hero-buttons">
                <a asp-controller="Home" asp-action="Contact" class="btn btn-primary">Get Started</a>
                <a asp-controller="Home" asp-action="Portfolio" class="btn btn-secondary">View Portfolio</a>
            </div>
        </div>
    </div>
</section>

<section class="services-preview">
    <div class="container">
        <h2 class="section-title">Our Services</h2>
        <div class="services-grid">
            @foreach (var service in ViewBag.Services as IEnumerable<Service> ?? Enumerable.Empty<Service>())
            {
                <div class="service-card">
                    <div class="service-icon">
                        <i class="@service.Icon"></i>
                    </div>
                    <h3>@service.Title</h3>
                    <p>@service.Description</p>
                </div>
            }
        </div>
        <div class="text-center" style="margin-top: 2rem;">
            <a asp-controller="Home" asp-action="Services" class="btn btn-outline">View All Services</a>
        </div>
    </div>
</section>

<section class="portfolio-preview">
    <div class="container">
        <h2 class="section-title">Featured Work</h2>
        <div class="portfolio-grid">
            @foreach (var item in (ViewBag.Portfolio as IEnumerable<PortfolioItem> ?? Enumerable.Empty<PortfolioItem>()).Take(6))
            {
                <div class="portfolio-item">
                    <div class="portfolio-image">
                        <img src="@item.ImageUrl" alt="@item.Title" />
                        <div class="portfolio-overlay">
                            <h4>@item.Title</h4>
                            <p>@item.Category</p>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center" style="margin-top: 2rem;">
            <a asp-controller="Home" asp-action="Portfolio" class="btn btn-outline">View Full Portfolio</a>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <h2>Ready to Get Started?</h2>
            <p>Contact us today for a free quote on your embroidery digitizing project</p>
            <a asp-controller="Home" asp-action="Contact" class="btn btn-primary btn-large">Contact Us</a>
        </div>
    </div>
</section>

