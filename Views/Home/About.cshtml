@{
    ViewData["Title"] = "About Us";
}

<section class="page-header">
    <div class="container">
        <h1>About ThreadifyLab</h1>
        <p>Your trusted partner in embroidery digitizing</p>
    </div>
</section>

<section class="about-content">
    <div class="container">
        <div class="about-section">
            <h2>Who We Are</h2>
            <p>ThreadifyLab is a leading provider of professional embroidery digitizing services. With years of experience in the industry, we specialize in converting your designs into high-quality embroidery files that bring your vision to life.</p>
        </div>

        <div class="about-section">
            <h2>Our Mission</h2>
            <p>Our mission is to deliver exceptional digitizing services that exceed our clients' expectations. We combine technical expertise with creative insight to produce embroidery files that are both beautiful and functional.</p>
        </div>

        <div class="about-section">
            <h2>Why Choose Us</h2>
            <div class="features-grid">
                <div class="feature-item">
                    <i class="fas fa-check-circle"></i>
                    <h3>Quality Guaranteed</h3>
                    <p>We ensure every file meets the highest standards of quality and precision.</p>
                </div>
                <div class="feature-item">
                    <i class="fas fa-clock"></i>
                    <h3>Fast Turnaround</h3>
                    <p>Quick delivery without compromising on quality.</p>
                </div>
                <div class="feature-item">
                    <i class="fas fa-dollar-sign"></i>
                    <h3>Competitive Pricing</h3>
                    <p>Affordable rates that fit your budget.</p>
                </div>
                <div class="feature-item">
                    <i class="fas fa-headset"></i>
                    <h3>Expert Support</h3>
                    <p>Dedicated support team ready to assist you.</p>
                </div>
            </div>
        </div>
    </div>
</section>

