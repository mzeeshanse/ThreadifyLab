@{
    ViewData["Title"] = "Pricing";
}

<section class="page-header">
    <div class="container">
        <h1>Pricing</h1>
        <p>Transparent and competitive pricing for all our digitizing services</p>
    </div>
</section>

<!-- Embroidery Digitizing Pricing Section -->
<section class="pricing-section">
    <div class="container">
        <h2 class="section-title">Embroidery Digitizing Pricing</h2>
        <p class="section-subtitle">Professional digitizing services for all your embroidery needs</p>
        
        <div class="pricing-grid">
            <!-- Cap Logo Card -->
            <div class="pricing-card">
                <div class="pricing-card-header">
                    <i class="fas fa-hat-cowboy"></i>
                    <h3>Cap Logo</h3>
                </div>
                <div class="pricing-card-body">
                    <div class="pricing-option">
                        <div class="pricing-type">Normal</div>
                        <div class="pricing-price">$15.00</div>
                        <div class="pricing-description">Standard cap logo digitizing with basic complexity</div>
                    </div>
                    <div class="pricing-divider"></div>
                    <div class="pricing-option">
                        <div class="pricing-type">Complex</div>
                        <div class="pricing-price">$25.00</div>
                        <div class="pricing-description">Advanced designs with multiple colors and details</div>
                    </div>
                </div>
            </div>

            <!-- Patches Card -->
            <div class="pricing-card">
                <div class="pricing-card-header">
                    <i class="fas fa-shield"></i>
                    <h3>Patches</h3>
                </div>
                <div class="pricing-card-body">
                    <div class="pricing-option">
                        <div class="pricing-type">Normal</div>
                        <div class="pricing-price">$20.00</div>
                        <div class="pricing-description">Standard patch digitizing with simple designs</div>
                    </div>
                    <div class="pricing-divider"></div>
                    <div class="pricing-option">
                        <div class="pricing-type">Complex</div>
                        <div class="pricing-price">$35.00</div>
                        <div class="pricing-description">Intricate patch designs with fine details</div>
                    </div>
                </div>
            </div>

            <!-- Jacket Back Card -->
            <div class="pricing-card">
                <div class="pricing-card-header">
                    <i class="fas fa-vest"></i>
                    <h3>Jacket Back</h3>
                </div>
                <div class="pricing-card-body">
                    <div class="pricing-option">
                        <div class="pricing-type">Normal</div>
                        <div class="pricing-price">$30.00</div>
                        <div class="pricing-description">Standard jacket back logo digitizing</div>
                    </div>
                    <div class="pricing-divider"></div>
                    <div class="pricing-option">
                        <div class="pricing-type">Complex</div>
                        <div class="pricing-price">$50.00</div>
                        <div class="pricing-description">Large and detailed jacket back designs</div>
                    </div>
                </div>
            </div>

            <!-- Chest Logo Card -->
            <div class="pricing-card">
                <div class="pricing-card-header">
                    <i class="fas fa-tshirt"></i>
                    <h3>Chest Logo</h3>
                </div>
                <div class="pricing-card-body">
                    <div class="pricing-option">
                        <div class="pricing-type">Normal</div>
                        <div class="pricing-price">$18.00</div>
                        <div class="pricing-description">Standard chest logo digitizing</div>
                    </div>
                    <div class="pricing-divider"></div>
                    <div class="pricing-option">
                        <div class="pricing-type">Complex</div>
                        <div class="pricing-price">$28.00</div>
                        <div class="pricing-description">Detailed chest logos with multiple elements</div>
                    </div>
                </div>
            </div>

            <!-- Badge Logo Card -->
            <div class="pricing-card">
                <div class="pricing-card-header">
                    <i class="fas fa-medal"></i>
                    <h3>Badge Logo</h3>
                </div>
                <div class="pricing-card-body">
                    <div class="pricing-option">
                        <div class="pricing-type">Normal</div>
                        <div class="pricing-price">$22.00</div>
                        <div class="pricing-description">Standard badge logo digitizing</div>
                    </div>
                    <div class="pricing-divider"></div>
                    <div class="pricing-option">
                        <div class="pricing-type">Complex</div>
                        <div class="pricing-price">$38.00</div>
                        <div class="pricing-description">Intricate badge designs with fine details</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Vector Art Pricing Section -->
<section class="pricing-section pricing-section-alt">
    <div class="container">
        <h2 class="section-title">Vector Art Pricing</h2>
        <p class="section-subtitle">Professional vector graphics conversion and creation services</p>
        
        <div class="pricing-grid pricing-grid-single">
            <div class="pricing-card pricing-card-featured">
                <div class="pricing-card-header">
                    <i class="fas fa-vector-square"></i>
                    <h3>Vector Art Services</h3>
                </div>
                <div class="pricing-card-body">
                    <div class="pricing-option pricing-option-full">
                        <div class="pricing-type">Logo Vectorization</div>
                        <div class="pricing-price">$25.00</div>
                        <div class="pricing-description">Convert raster images to clean, scalable vector graphics</div>
                    </div>
                    <div class="pricing-divider"></div>
                    <div class="pricing-option pricing-option-full">
                        <div class="pricing-type">Custom Vector Art</div>
                        <div class="pricing-price">$40.00</div>
                        <div class="pricing-description">Professional vector illustrations created from scratch</div>
                    </div>
                    <div class="pricing-divider"></div>
                    <div class="pricing-option pricing-option-full">
                        <div class="pricing-type">Vector Art Cleanup</div>
                        <div class="pricing-price">$20.00</div>
                        <div class="pricing-description">Clean and optimize existing vector files</div>
                    </div>
                    <div class="pricing-divider"></div>
                    <div class="pricing-option pricing-option-full">
                        <div class="pricing-type">Complex Vector Graphics</div>
                        <div class="pricing-price">$60.00</div>
                        <div class="pricing-description">Detailed vector graphics with multiple layers and elements</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <h2>Ready to Get Started?</h2>
            <p>Contact us today to discuss your project requirements and get a custom quote</p>
            <a asp-controller="Home" asp-action="Contact" class="btn btn-primary btn-large">Get a Quote</a>
        </div>
    </div>
</section>

<style>
    .pricing-section {
        padding: 4rem 0;
        background-color: var(--bg-primary);
    }

    .pricing-section-alt {
        background-color: var(--bg-secondary);
    }

    .section-title {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
    }

    .section-subtitle {
        text-align: center;
        color: var(--text-secondary);
        margin-bottom: 3rem;
        font-size: 1.1rem;
    }

    .pricing-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .pricing-grid-single {
        grid-template-columns: 1fr;
        max-width: 600px;
        margin: 2rem auto 0;
    }

    .pricing-card {
        background-color: var(--bg-secondary);
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 4px 6px var(--shadow);
        transition: transform 0.3s, box-shadow 0.3s;
        border: 1px solid var(--border-color);
    }

    .pricing-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px var(--shadow);
    }

    .pricing-card-featured {
        background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%);
        border: 2px solid var(--primary-color);
    }

    .pricing-card-header {
        text-align: center;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid var(--border-color);
    }

    .pricing-card-header i {
        font-size: 3rem;
        color: var(--primary-color);
        margin-bottom: 1rem;
        display: block;
    }

    .pricing-card-header h3 {
        font-size: 1.75rem;
        color: var(--text-primary);
        margin: 0;
    }

    .pricing-card-body {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .pricing-option {
        padding: 1.5rem 0;
        text-align: center;
    }

    .pricing-option-full {
        padding: 1.25rem 0;
    }

    .pricing-type {
        font-size: 1rem;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .pricing-price {
        font-size: 2.5rem;
        font-weight: bold;
        color: var(--primary-color);
        margin-bottom: 0.75rem;
    }

    .pricing-description {
        font-size: 0.95rem;
        color: var(--text-muted);
        line-height: 1.6;
    }

    .pricing-divider {
        height: 1px;
        background: linear-gradient(to right, transparent, var(--border-color), transparent);
        margin: 0.5rem 0;
    }

    @@media (max-width: 768px) {
        .pricing-grid {
            grid-template-columns: 1fr;
        }

        .section-title {
            font-size: 2rem;
        }

        .pricing-card {
            padding: 1.5rem;
        }

        .pricing-price {
            font-size: 2rem;
        }
    }
</style>

