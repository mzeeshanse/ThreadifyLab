@using ThreadifyLab.Models
@{
    ViewData["Title"] = "Pricing";
    var embroideryPricing = ViewBag.EmbroideryPricing as IEnumerable<Pricing> ?? Enumerable.Empty<Pricing>();
    var vectorArtPricing = ViewBag.VectorArtPricing as IEnumerable<Pricing> ?? Enumerable.Empty<Pricing>();
    
    // Group embroidery pricing by ServiceName, excluding Patches
    var embroideryGroups = embroideryPricing
        .Where(p => p.IsActive && !p.ServiceName.Equals("Patches", StringComparison.OrdinalIgnoreCase))
        .GroupBy(p => p.ServiceName)
        .OrderBy(g => g.First().DisplayOrder)
        .ThenBy(g => g.Key);
}

<section class="page-header">
    <div class="container">
        <h1>Pricing</h1>
        <p>Transparent and competitive pricing for all our digitizing services</p>
    </div>
</section>

<!-- Embroidery Digitizing Pricing Section -->
<section class="pricing-section">
    <div class="container">
        <h2 class="section-title">Embroidery Digitizing Pricing</h2>
        <p class="section-subtitle">Professional digitizing services for all your embroidery needs</p>
        
        <div class="pricing-grid">
            @foreach (var serviceGroup in embroideryGroups)
            {
                var firstItem = serviceGroup.First();
                var pricingItems = serviceGroup.OrderBy(p => p.ServiceType == "Normal" ? 0 : 1).ToList();
                
                <div class="pricing-card">
                    <div class="pricing-card-header">
                        <i class="@firstItem.Icon"></i>
                        <h3>@firstItem.ServiceName</h3>
                    </div>
                    <div class="pricing-card-body">
                        @for (int i = 0; i < pricingItems.Count; i++)
                        {
                            var item = pricingItems[i];
                            <div class="pricing-option">
                                <div class="pricing-type">@item.ServiceType</div>
                                <div class="pricing-price">$@item.Price.ToString("F2")</div>
                                <div class="pricing-description">@item.Description</div>
                            </div>
                            @if (i < pricingItems.Count - 1)
                            {
                                <div class="pricing-divider"></div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Vector Art Pricing Section -->
<section class="pricing-section pricing-section-alt">
    <div class="container">
        <h2 class="section-title">Vector Art Pricing</h2>
        <p class="section-subtitle">Professional vector graphics conversion and creation services</p>
        
        <div class="pricing-grid pricing-grid-single">
            @if (vectorArtPricing.Any(p => p.IsActive))
            {
                var vectorArtItems = vectorArtPricing
                    .Where(p => p.IsActive)
                    .OrderBy(p => p.DisplayOrder)
                    .ThenBy(p => p.ServiceType)
                    .ToList();
                
                var firstVectorItem = vectorArtItems.First();
                
                <div class="pricing-card pricing-card-featured">
                    <div class="pricing-card-header">
                        <i class="@firstVectorItem.Icon"></i>
                        <h3>@firstVectorItem.ServiceName</h3>
                    </div>
                    <div class="pricing-card-body">
                        @for (int i = 0; i < vectorArtItems.Count; i++)
                        {
                            var item = vectorArtItems[i];
                            <div class="pricing-option pricing-option-full">
                                <div class="pricing-type">@item.ServiceType</div>
                                <div class="pricing-price">$@item.Price.ToString("F2")</div>
                                <div class="pricing-description">@item.Description</div>
                            </div>
                            @if (i < vectorArtItems.Count - 1)
                            {
                                <div class="pricing-divider"></div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="cta-content">
            <h2>Ready to Get Started?</h2>
            <p>Contact us today to discuss your project requirements and get a custom quote</p>
            <a asp-controller="Home" asp-action="Contact" class="btn btn-primary btn-large">Get a Quote</a>
        </div>
    </div>
</section>

<style>
    .pricing-section {
        padding: 4rem 0;
        background-color: var(--bg-primary);
    }

    .pricing-section-alt {
        background-color: var(--bg-secondary);
    }

    .section-title {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
    }

    .section-subtitle {
        text-align: center;
        color: var(--text-secondary);
        margin-bottom: 3rem;
        font-size: 1.1rem;
    }

    .pricing-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2rem;
        margin-top: 2rem;
    }

    .pricing-grid-single {
        grid-template-columns: 1fr;
        max-width: 600px;
        margin: 2rem auto 0;
    }

    .pricing-card {
        background-color: var(--bg-secondary);
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 4px 6px var(--shadow);
        transition: transform 0.3s, box-shadow 0.3s;
        border: 1px solid var(--border-color);
    }

    .pricing-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px var(--shadow);
    }

    .pricing-card-featured {
        background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-tertiary) 100%);
        border: 2px solid var(--primary-color);
    }

    .pricing-card-header {
        text-align: center;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid var(--border-color);
    }

    .pricing-card-header i {
        font-size: 3rem;
        color: var(--primary-color);
        margin-bottom: 1rem;
        display: block;
    }

    .pricing-card-header h3 {
        font-size: 1.75rem;
        color: var(--text-primary);
        margin: 0;
    }

    .pricing-card-body {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .pricing-option {
        padding: 1.5rem 0;
        text-align: center;
    }

    .pricing-option-full {
        padding: 1.25rem 0;
    }

    .pricing-type {
        font-size: 1rem;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .pricing-price {
        font-size: 2.5rem;
        font-weight: bold;
        color: var(--primary-color);
        margin-bottom: 0.75rem;
    }

    .pricing-description {
        font-size: 0.95rem;
        color: var(--text-muted);
        line-height: 1.6;
    }

    .pricing-divider {
        height: 1px;
        background: linear-gradient(to right, transparent, var(--border-color), transparent);
        margin: 0.5rem 0;
    }

    @@media (max-width: 1200px) {
        .pricing-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .pricing-grid {
            grid-template-columns: 1fr;
        }

        .section-title {
            font-size: 2rem;
        }

        .pricing-card {
            padding: 1.5rem;
        }

        .pricing-price {
            font-size: 2rem;
        }
    }
</style>

