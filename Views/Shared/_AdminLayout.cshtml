<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin | ThreadifyLab</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="admin-body">
    <div class="admin-container">
        <aside class="admin-sidebar">
            <div class="admin-brand">
                <img src="~/images/logo.png" alt="ThreadifyLab" class="admin-logo" />
                <span class="admin-brand-text">Admin</span>
            </div>
            <nav class="admin-nav">
                <a asp-controller="Admin" asp-action="Index" class="nav-link">
                    <i class="fas fa-dashboard"></i> Dashboard
                </a>
                <a asp-controller="Admin" asp-action="Services" class="nav-link">
                    <i class="fas fa-cog"></i> Services
                </a>
                <a asp-controller="Admin" asp-action="CapLogos" class="nav-link">
                    <i class="fas fa-hat-cowboy"></i> Cap Logos
                </a>
                <a asp-controller="Admin" asp-action="Patches" class="nav-link">
                    <i class="fas fa-patch"></i> Patches
                </a>
                <a asp-controller="Admin" asp-action="JacketBacks" class="nav-link">
                    <i class="fas fa-vest"></i> Jacket Backs
                </a>
                <a asp-controller="Admin" asp-action="ChestLogos" class="nav-link">
                    <i class="fas fa-tshirt"></i> Chest Logos
                </a>
                <a asp-controller="Admin" asp-action="BadgeLogos" class="nav-link">
                    <i class="fas fa-id-badge"></i> Badge Logos
                </a>
                <a asp-controller="Admin" asp-action="VectorArts" class="nav-link">
                    <i class="fas fa-vector-square"></i> Vector Arts
                </a>
                <a asp-controller="Admin" asp-action="Pricings" class="nav-link">
                    <i class="fas fa-dollar-sign"></i> Pricing
                </a>
                <a asp-controller="Admin" asp-action="Portfolio" class="nav-link">
                    <i class="fas fa-images"></i> Portfolio
                </a>
                <a asp-controller="Admin" asp-action="Messages" class="nav-link">
                    <i class="fas fa-envelope"></i> Messages
                </a>
                <a asp-controller="Admin" asp-action="Logout" class="nav-link">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </nav>
        </aside>

        <main class="admin-main">
            <header class="admin-header">
                <h1>@ViewData["Title"]</h1>
            </header>

            <div class="admin-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

