<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ThreadifyLab | Professional Embroidery Digitizing Services</title>
    <meta name="description" content="Professional embroidery digitizing services. High-quality digitizing for logos, designs, and custom embroidery. Fast turnaround and competitive pricing." />
    <meta name="keywords" content="embroidery digitizing, digitizing services, embroidery design, logo digitizing, custom embroidery" />
    <meta name="author" content="ThreadifyLab" />
    <meta property="og:title" content="ThreadifyLab - Professional Embroidery Digitizing Services" />
    <meta property="og:description" content="High-quality embroidery digitizing services for your business needs." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://threadifylab.com" />
    <link rel="canonical" href="https://threadifylab.com@(Context.Request.Path)" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <div class="nav-brand">
                    <a asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo.png" alt="ThreadifyLab" class="logo-img" />
                    </a>
                </div>
                <button class="nav-toggle" aria-label="Toggle navigation">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <ul class="nav-menu">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Home" asp-action="About">About</a></li>
                    <li><a asp-controller="Home" asp-action="Pricing">Pricing</a></li>
                    <li class="nav-dropdown">
                        <a href="#" class="nav-dropdown-toggle">
                            Embroidery Digitizing <i class="fas fa-chevron-down"></i>
                        </a>
                        <ul class="nav-dropdown-menu">
                            <li><a asp-controller="Home" asp-action="CapLogo">Cap Logo</a></li>
                            <li><a asp-controller="Home" asp-action="Patches">Patches</a></li>
                            <li><a asp-controller="Home" asp-action="JacketBack">Jacket Back</a></li>
                            <li><a asp-controller="Home" asp-action="ChestLogo">Chest Logo</a></li>
                            <li><a asp-controller="Home" asp-action="BadgeLogo">Badge Logo</a></li>
                        </ul>
                    </li>
                    <li><a asp-controller="Home" asp-action="VectorArt">Vector Art</a></li>
                    <li><a asp-controller="Home" asp-action="Portfolio">Portfolio</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-user">
                            <a asp-controller="User" asp-action="Dashboard">
                                <i class="fas fa-user"></i> <span class="nav-user-name">@User.Identity.Name</span>
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li>
                                <a asp-controller="Admin" asp-action="Index" class="nav-admin-link">
                                    <i class="fas fa-cog"></i> Admin Panel
                                </a>
                            </li>
                        }
                        <li>
                            <form asp-controller="User" asp-action="Logout" method="post" style="display: inline;">
                                <button type="submit" class="btn-link">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li><a asp-controller="User" asp-action="Login">Login</a></li>
                        <li><a asp-controller="User" asp-action="Register" class="btn-nav-signup">Sign Up</a></li>
                        <li class="nav-admin-item">
                            <a asp-controller="Admin" asp-action="Login" class="nav-admin-link" title="Admin Login">
                                <i class="fas fa-cog"></i> <span class="nav-admin-text">Admin</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <!-- Image Modal -->
    <div id="imageModal" class="image-modal">
        <span class="image-modal-close">&times;</span>
        <img class="image-modal-content" id="modalImage" alt="Full size image">
    </div>

    <footer>
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <img src="~/images/logo.png" alt="ThreadifyLab" class="footer-logo" />
                    <p>Professional embroidery digitizing services for your business needs.</p>
                </div>
                <div class="footer-section">
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Home" asp-action="About">About</a></li>
                        <li><a asp-controller="Home" asp-action="Pricing">Pricing</a></li>
                        <li><a asp-controller="Home" asp-action="Portfolio">Portfolio</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Contact</h4>
                    <p><i class="fas fa-envelope"></i> info@threadifylab.com</p>
                    <p><i class="fas fa-globe"></i> threadifylab.com</p>
                    @if (User.IsInRole("Admin"))
                    {
                        <p style="margin-top: 1rem;">
                            <a asp-controller="Admin" asp-action="Index" style="color: var(--primary-color); text-decoration: none;">
                                <i class="fas fa-cog"></i> Admin Panel
                            </a>
                        </p>
                    }
                    else
                    {
                        <p style="margin-top: 1rem;">
                            <a asp-controller="Admin" asp-action="Login" style="color: var(--text-secondary); text-decoration: none; font-size: 0.9rem;">
                                <i class="fas fa-cog"></i> Admin Login
                            </a>
                        </p>
                    }
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year ThreadifyLab. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <!-- Suppress harmless WebSocket errors from ASP.NET Core browser refresh -->
    <script>
        // Suppress WebSocket connection errors from aspnetcore-browser-refresh
        window.addEventListener('error', function(e) {
            if (e.message && e.message.includes('WebSocket connection') && e.message.includes('aspnetcore-browser-refresh')) {
                e.preventDefault();
                return false;
            }
        }, true);
        
        // Also catch unhandled promise rejections
        window.addEventListener('unhandledrejection', function(e) {
            if (e.reason && e.reason.message && e.reason.message.includes('WebSocket') && e.reason.message.includes('aspnetcore-browser-refresh')) {
                e.preventDefault();
                return false;
            }
        });
    </script>
</body>
</html>

