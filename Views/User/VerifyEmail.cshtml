@{
    ViewData["Title"] = "Verify Email";
}

<section class="page-header">
    <div class="container">
        <h1>Email Verification</h1>
    </div>
</section>

<section class="auth-section">
    <div class="container">
        <div class="auth-container">
            <div class="auth-box text-center">
                @if (ViewBag.Success == true)
                {
                    <div class="success-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h2>Email Verified!</h2>
                    <div class="alert alert-success">
                        @ViewBag.Message
                    </div>
                    <a asp-controller="User" asp-action="Login" class="btn btn-primary">Go to Login</a>
                }
                else
                {
                    <div class="error-icon">
                        <i class="fas fa-times-circle"></i>
                    </div>
                    <h2>Verification Failed</h2>
                    <div class="alert alert-danger">
                        @ViewBag.Message
                    </div>
                    <div class="auth-footer">
                        <p>You can request a new verification email from the <a asp-controller="User" asp-action="Login">login page</a>.</p>
                        <a asp-controller="User" asp-action="Login" class="btn btn-primary">Go to Login</a>
                    </div>
                }
            </div>
        </div>
    </div>
</section>



