@model IEnumerable<Service>
@{
    ViewData["Title"] = "Manage Services";
    Layout = "_AdminLayout";
}

<div class="admin-actions">
    <a asp-controller="Admin" asp-action="CreateService" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add New Service
    </a>
</div>

<div class="admin-table-container">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Icon</th>
                <th>Display Order</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var service in Model)
            {
                <tr>
                    <td>@service.Id</td>
                    <td>@service.Title</td>
                    <td><i class="@service.Icon"></i></td>
                    <td>@service.DisplayOrder</td>
                    <td>
                        @if (service.IsActive)
                        {
                            <span class="badge badge-success">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-inactive">Inactive</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="Admin" asp-action="EditService" asp-route-id="@service.Id" class="btn btn-sm btn-edit">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <form asp-controller="Admin" asp-action="DeleteService" asp-route-id="@service.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this service?');">
                            <button type="submit" class="btn btn-sm btn-delete">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

