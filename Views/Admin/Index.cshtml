@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<div class="dashboard-grid">
    <div class="dashboard-card">
        <div class="dashboard-icon">
            <i class="fas fa-envelope"></i>
        </div>
        <div class="dashboard-content">
            <h3>@ViewBag.UnreadMessages</h3>
            <p>Unread Messages</p>
        </div>
        <a asp-controller="Admin" asp-action="Messages" class="dashboard-link">View All</a>
    </div>

    <div class="dashboard-card">
        <div class="dashboard-icon">
            <i class="fas fa-cog"></i>
        </div>
        <div class="dashboard-content">
            <h3>@ViewBag.ServicesCount</h3>
            <p>Services</p>
        </div>
        <a asp-controller="Admin" asp-action="Services" class="dashboard-link">Manage</a>
    </div>

    <div class="dashboard-card">
        <div class="dashboard-icon">
            <i class="fas fa-images"></i>
        </div>
        <div class="dashboard-content">
            <h3>@ViewBag.PortfolioCount</h3>
            <p>Portfolio Items</p>
        </div>
        <a asp-controller="Admin" asp-action="Portfolio" class="dashboard-link">Manage</a>
    </div>
</div>

