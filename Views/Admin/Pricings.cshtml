@model IEnumerable<Pricing>
@{
    ViewData["Title"] = "Manage Pricing";
    Layout = "_AdminLayout";
}

<div class="admin-actions">
    <a asp-controller="Admin" asp-action="CreatePricing" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add New Pricing
    </a>
</div>

<div class="admin-table-container">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Service Name</th>
                <th>Type</th>
                <th>Category</th>
                <th>Price</th>
                <th>Icon</th>
                <th>Display Order</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pricing in Model)
            {
                <tr>
                    <td>@pricing.Id</td>
                    <td>@pricing.ServiceName</td>
                    <td>@pricing.ServiceType</td>
                    <td>@pricing.Category</td>
                    <td>$@pricing.Price.ToString("F2")</td>
                    <td><i class="@pricing.Icon"></i></td>
                    <td>@pricing.DisplayOrder</td>
                    <td>
                        @if (pricing.IsActive)
                        {
                            <span class="badge badge-success">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-inactive">Inactive</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="Admin" asp-action="EditPricing" asp-route-id="@pricing.Id" class="btn btn-sm btn-edit">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <form asp-controller="Admin" asp-action="DeletePricing" asp-route-id="@pricing.Id" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this pricing?');">
                            <button type="submit" class="btn btn-sm btn-delete">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

