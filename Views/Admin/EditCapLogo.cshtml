@model CapLogo
@{
    ViewData["Title"] = "Edit Cap Logo";
    Layout = "_AdminLayout";
}

<div class="admin-form-container">
    <h2>Edit Cap Logo</h2>
    
    <form asp-controller="Admin" asp-action="EditCapLogo" method="post" class="admin-form" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden" />
        <input asp-for="ImageUrl" type="hidden" />
        
        <div class="form-group">
            <label asp-for="Title">Title *</label>
            <input asp-for="Title" class="form-control" required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">Description *</label>
            <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="imageFile">Image</label>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div style="margin-bottom: 1rem;">
                    <label>Current Image:</label>
                    <div>
                        <img src="@Model.ImageUrl" alt="Current image" style="max-width: 300px; max-height: 300px; border-radius: 8px; border: 1px solid #ddd;" />
                    </div>
                </div>
            }
            <input type="file" id="imageFile" name="imageFile" accept="image/jpeg,image/jpg,image/png,image/gif,image/webp" class="form-control" />
            <small class="form-text text-muted">Leave empty to keep current image. Allowed formats: JPG, JPEG, PNG, GIF, WEBP. Max size: 5MB</small>
            <span asp-validation-for="ImageUrl" class="text-danger"></span>
            @if (ViewData.ModelState["imageFile"]?.Errors.Count > 0)
            {
                <span class="text-danger">@ViewData.ModelState["imageFile"].Errors[0].ErrorMessage</span>
            }
            <div id="imagePreview" style="margin-top: 1rem; display: none;">
                <label>New Image Preview:</label>
                <div>
                    <img id="previewImg" src="" alt="Preview" style="max-width: 300px; max-height: 300px; border-radius: 8px; border: 1px solid #ddd;" />
                </div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="DisplayOrder">Display Order</label>
                <input asp-for="DisplayOrder" type="number" class="form-control" />
            </div>

            <div class="form-group">
                <label>
                    <input asp-for="IsActive" type="checkbox" /> Active
                </label>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Update Cap Logo</button>
            <a asp-controller="Admin" asp-action="CapLogos" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}



